{
    "name": "itqan/flarum-notifications",
    "description": "Per-tag notification channel preferences for the Itqan community",
    "keywords": ["flarum", "notifications", "tags", "email"],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Itqan Community",
            "email": "a.abduraghman@itqan.dev"
        }
    ],
    "require": {
        "flarum/core": "^1.8.0",
        "flarum/tags": "^1.8.0"
    },
    "autoload": {
        "psr-4": {
            "Itqan\\Notifications\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Itqan Notifications",
            "category": "feature",
            "icon": {
                "name": "fas fa-bell",
                "color": "#ffffff",
                "backgroundColor": "#064e3b"
            },
            "optional-dependencies": [
                "fof-follow-tags",
                "askvortsov-pwa"
            ]
        }
    }
}
