{
    "name": "itqan/flarum-notifications",
    "description": "Notify discussion authors of new replies with the reply text as the preview",
    "keywords": [
        "flarum",
        "notifications",
        "replies"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Itqan Community",
            "email": "a.abduraghman@itqan.dev"
        }
    ],
    "require": {
        "flarum/core": "^1.8.0",
        "flarum/subscriptions": "*"
    },
    "autoload": {
        "psr-4": {
            "Itqan\\Notifications\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Itqan Notifications",
            "category": "feature",
            "icon": {
                "name": "fas fa-bell",
                "color": "#ffffff",
                "backgroundColor": "#064e3b"
            }
        }
    },
    "scripts": {
        "build": "cd js && npm run build"
    }
}
