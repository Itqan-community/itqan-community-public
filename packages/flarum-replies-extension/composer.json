{
  "name": "mtareq/flarum-nested-replies",
  "description": "Restyle Flarum discussions as nested reply threads with indentation, collapsible comments and voting.",
  "keywords": ["flarum", "theme", "nested", "threads", "replies", "discussion"],
  "license": "MIT",
  "type": "flarum-extension",
  "require": {
    "flarum/core": "^1.8 || ^2.0"
  },
  "autoload": {
    "psr-4": {
      "Mtareq\\NestedReplies\\": "src/"
    }
  },
  "extra": {
    "flarum-extension": {
      "title": "Nested Replies",
      "category": "theme",
      "icon": {
        "name": "fas fa-comments",
        "backgroundColor": "#FF4500",
        "color": "#fff"
      }
    }
  }
}
