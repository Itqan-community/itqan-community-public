{
    "name": "itqan/flarum-statistics",
    "description": "Community analytics dashboard with daily trends, engagement segmentation, rolling 12-month charts, and team tracking.",
    "keywords": ["flarum", "statistics", "analytics", "dashboard", "teams", "itqan"],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Itqan Community",
            "email": "a.abduraghman@itqan.dev"
        }
    ],
    "require": {
        "flarum/core": "^1.8.0 || ^2.0.0"
    },
    "autoload": {
        "psr-4": {
            "Itqan\\Statistics\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Itqan Community Statistics",
            "category": "feature",
            "icon": {
                "name": "fas fa-chart-line",
                "color": "#ffffff",
                "backgroundColor": "#0d9488"
            }
        }
    }
}
