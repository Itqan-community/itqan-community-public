{
    "name": "itqan/user-badges",
    "description": "User badges with image artwork, ported from v17development/flarum-user-badges to Flarum 2.0",
    "keywords": ["flarum", "badges", "recognition"],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Itqan Community",
            "email": "a.abduraghman@itqan.dev"
        }
    ],
    "require": {
        "flarum/core": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Itqan\\UserBadges\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Itqan User Badges",
            "category": "feature",
            "icon": {
                "name": "fas fa-user-tag",
                "color": "#ffffff",
                "backgroundColor": "#0D9488"
            }
        }
    }
}
