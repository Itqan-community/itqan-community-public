{
    "name": "flarum/flarum",
    "description": "Delightfully simple forum software.",
    "type": "project",
    "keywords": [
        "forum",
        "discussion"
    ],
    "homepage": "https://flarum.org/",
    "license": "MIT",
    "authors": [
        {
            "name": "Flarum",
            "email": "info@flarum.org",
            "homepage": "https://flarum.org/team"
        }
    ],
    "support": {
        "issues": "https://github.com/flarum/core/issues",
        "source": "https://github.com/flarum/flarum",
        "docs": "https://docs.flarum.org/"
    },
    "require": {
        "acpl/mobile-tab": "*",
        "clarkwinkelmann/flarum-ext-likes-received": "*",
        "datlechin/flarum-copy-links": "*",
        "datlechin/flarum-discussion-count": "*",
        "ekumanov/flarum-ext-markdown-tables": "*",
        "flarum-lang/arabic": "^2.0",
        "flarum/approval": "*",
        "flarum/audit": "*",
        "flarum/bbcode": "*",
        "flarum/core": "^2.0",
        "flarum/emoji": "*",
        "flarum/extension-manager": "*",
        "flarum/flags": "*",
        "flarum/lang-english": "*",
        "flarum/likes": "*",
        "flarum/lock": "*",
        "flarum/markdown": "*",
        "flarum/mentions": "*",
        "flarum/messages": "*",
        "flarum/nicknames": "*",
        "flarum/statistics": "*",
        "flarum/sticky": "*",
        "flarum/subscriptions": "*",
        "flarum/suspend": "*",
        "flarum/tags": "*",
        "fof/analytics": "*",
        "fof/author-change": "*",
        "fof/badges": "*",
        "fof/discussion-language": "*",
        "fof/disposable-emails": "*",
        "fof/formatting": "*",
        "fof/linguist": "*",
        "fof/links": "*",
        "fof/merge-discussions": "*",
        "fof/oauth": "*",
        "fof/pwa": "^2.0",
        "fof/reactions": "*",
        "fof/share-social": "*",
        "fof/socialprofile": "*",
        "fof/upload": "*",
        "fof/user-bio": "*",
        "fof/webhooks": "*",
        "ianm/follow-users": "*",
        "ianm/html-head": "*",
        "irmmr/flarum-ext-rtl": "*",
        "itqan/flarum-composer-tools": "@dev",
        "itqan/flarum-mailerlite": "@dev",
        "itqan/flarum-notifications": "@dev",
        "itqan/flarum-statistics": "@dev",
        "itqan/flarum-theme": "@dev",
        "itqan/flarum-typography": "@dev",
        "michaelbelgium/flarum-discussion-views": "*",
        "mtareq/flarum-nested-replies": "@dev",
        "resofire/mobile-search": "*",
        "v17development/flarum-seo": "*",
        "xxb5724/id-slug": "*",
        "itqan/lang-arabic": "@dev",
        "itqan/sitemap": "@dev",
        "itqan/translate": "@dev",
        "itqan/flarum-preview-cards": "@dev",
        "itqan/pretty-mail": "@dev"
    },
    "config": {
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        },
        "platform": {
            "php": "8.4.0"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/itqan-composer-tools"
        },
        {
            "type": "path",
            "url": "packages/itqan-mailerlite"
        },
        {
            "type": "path",
            "url": "packages/itqan-notifications"
        },
        {
            "type": "path",
            "url": "packages/itqan-statistics"
        },
        {
            "type": "path",
            "url": "packages/itqan-theme"
        },
        {
            "type": "path",
            "url": "packages/itqan-typography"
        },
        {
            "type": "path",
            "url": "packages/flarum-replies-extension"
        },
        {
            "type": "path",
            "url": "packages/itqan-lang-arabic"
        },
        {
            "type": "path",
            "url": "packages/itqan-sitemap"
        },
        {
            "type": "path",
            "url": "packages/itqan-translate"
        },
        {
            "type": "path",
            "url": "packages/itqan-preview-cards"
        },
        {
            "type": "path",
            "url": "packages/itqan-pretty-mail"
        }
    ],
    "minimum-stability": "beta",
    "prefer-stable": true
}
